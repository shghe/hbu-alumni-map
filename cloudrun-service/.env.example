# 复制为 .env 后填写真实值，切勿把 .env 提交到 git

# === 微信 ===
WX_APPID=
WX_SECRET=

# === 腾讯 COS ===
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=

# === 媒体访问签名（必须配置随机长字符串，多实例保持一致） ===
MEDIA_STREAM_SECRET=

# === MySQL ===
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# === JWT（必须配置随机长字符串） ===
JWT_SECRET=

# === CORS 白名单（留空则不返回跨域头） ===
CORS_ALLOW_ORIGIN=

# === 可选 ===
PORT=3002
PUBLIC_CLIENT_KEY=hbu-alumni-map-miniapp-v3
MEDIA_URL_TTL=604800
