.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #e7ecea;
}

.map {
  width: 100vw;
  height: 100vh;
}

.header {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  right: 24rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 36rpx rgba(14, 44, 36, 0.12);
}

.header-left {
  flex: 1;
  min-width: 0;
}

.eyebrow {
  color: #6d7a75;
  font-size: 22rpx;
  line-height: 1.3;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 4rpx;
}

.title {
  color: #0b5d4a;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
}

.city-picker {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 16rpx 4rpx 12rpx;
  border: 1rpx solid #dbe4e0;
  border-radius: 6px;
  background: #f7faf9;
  color: #0b5d4a;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
  white-space: nowrap;
}

.summary {
  margin-top: 6rpx;
  color: #4e5c57;
  font-size: 24rpx;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.admin-entry {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #edf4f1;
  color: #0b5d4a;
  font-size: 30rpx;
  line-height: 56rpx;
  text-align: center;
}

.locate-button {
  flex: 0 0 auto;
  min-width: 112rpx;
  height: 64rpx;
  padding: 0 24rpx;
  background: #0b5d4a;
  color: #ffffff;
  font-size: 26rpx;
}

.panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
  padding: 24rpx 24rpx 18rpx;
  border-radius: 18rpx 18rpx 0 0;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -18rpx 50rpx rgba(14, 44, 36, 0.14);
}

.search-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 72rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border: 1rpx solid #dbe4e0;
  border-radius: 8px;
  background: #f7faf9;
  color: #17201d;
  font-size: 28rpx;
}

.traffic-button {
  width: 104rpx;
  height: 72rpx;
  border: 1rpx solid #dbe4e0;
  background: #ffffff;
  color: #33413c;
  font-size: 26rpx;
}

.traffic-button.active {
  border-color: #0b5d4a;
  background: #e6f3ef;
  color: #0b5d4a;
  font-weight: 600;
}

.filter-scroll {
  margin-top: 18rpx;
  white-space: nowrap;
}

.filter-list {
  display: flex;
  gap: 14rpx;
}

.filter-chip {
  flex: 0 0 auto;
  height: 58rpx;
  padding: 0 22rpx;
  border: 1rpx solid #dbe4e0;
  background: #ffffff;
  color: #33413c;
  font-size: 24rpx;
}

.filter-chip.active {
  border-color: #0b5d4a;
  background: #0b5d4a;
  color: #ffffff;
}

.home-list {
  max-height: 43vh;
  margin-top: 18rpx;
}

.home-card {
  display: flex;
  gap: 18rpx;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eef2f0;
}

.home-main {
  min-width: 0;
  flex: 1;
}

.home-title {
  color: #17201d;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.home-meta,
.home-address {
  margin-top: 8rpx;
  color: #5b6964;
  font-size: 24rpx;
  line-height: 1.35;
}

.home-address {
  text-decoration: underline;
  text-decoration-color: #cbd8d3;
  text-underline-offset: 4rpx;
  cursor: pointer;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.tag {
  padding: 6rpx 12rpx;
  border-radius: 6px;
  background: #edf4f1;
  color: #0b5d4a;
  font-size: 22rpx;
  line-height: 1.2;
}

.card-actions {
  flex: 0 0 112rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.nav-button {
  width: 104rpx;
  height: 60rpx;
  background: #d89b2b;
  color: #ffffff;
  font-size: 24rpx;
}

.distance {
  color: #6d7a75;
  font-size: 22rpx;
}

.empty {
  padding: 60rpx 0;
  text-align: center;
  color: #7c8a85;
  font-size: 26rpx;
}
