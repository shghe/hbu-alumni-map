<scroll-view class="page safe-bottom" scroll-y enhanced show-scrollbar="{{false}}">
  <swiper
    wx:if="{{home.photos.length > 0}}"
    class="photo-swiper"
    indicator-dots
    circular
    autoplay
    interval="4200"
  >
    <swiper-item wx:for="{{home.photos}}" wx:key="*this">
      <image
        class="photo"
        src="{{item}}"
        mode="aspectFill"
        lazy-load
        data-index="{{index}}"
        bindtap="previewPhoto"
      />
    </swiper-item>
  </swiper>

  <view wx:else class="photo-placeholder">
    <view class="placeholder-title">校友之家照片</view>
    <view class="placeholder-subtitle">可在 data/homes.js 中补充图片路径</view>
  </view>

  <view wx:if="{{home.hasVideo}}" class="video-card" bindtap="playVideo">
    <image wx:if="{{home.videoPoster}}" class="video-poster" src="{{home.videoPoster}}" mode="aspectFill" />
    <view wx:else class="video-placeholder-bg" />
    <view class="video-play-btn">
      <text class="video-play-icon">▶</text>
      <text class="video-play-label">播放视频介绍</text>
    </view>
  </view>

  <view class="content">
    <view class="city">{{home.city}}</view>
    <view class="name">{{home.name}}</view>
    <view class="description">
      <view wx:for="{{home.descriptionLines}}" wx:key="*this" class="desc-line">{{item}}{{item === '' ? ' ' : ''}}</view>
    </view>

    <view class="action-row">
      <button class="primary-action" bindtap="openLocation">地图导航</button>
      <button class="secondary-action" bindtap="makePhoneCall">拨打电话</button>
    </view>

    <view class="section">
      <view class="section-title">服务内容</view>
      <view class="service-grid">
        <text wx:for="{{home.services}}" wx:key="*this" class="service-item">{{item}}</text>
      </view>
    </view>

    <view class="section">
      <view class="section-title">联系信息</view>
      <view class="info-row">
        <text class="info-label">联系人</text>
        <text class="info-value">{{home.contactName}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">电话</text>
        <text class="info-value">{{home.phone}}</text>
      </view>
      <view class="info-row copyable" bindtap="copyWechat">
        <text class="info-label">微信</text>
        <text class="info-value">{{home.wechat}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">服务时间</text>
        <text class="info-value">{{home.hours}}</text>
      </view>
    </view>

    <view class="section">
      <view class="section-title">地址</view>
      <view class="address-card" bindtap="copyAddress">
        {{home.address}}
      </view>
    </view>
  </view>
</scroll-view>
