<view class="page safe-bottom">
  <!-- Login Gate -->
  <view wx:if="{{!authenticated}}" class="login-box">
    <view wx:if="{{myOpenid}}" class="openid-card">
      <view class="openid-card-row">
        <text class="openid-card-label">你的微信身份</text>
        <button class="copy-btn" bindtap="copyOpenid">复制</button>
      </view>
      <text class="openid-card-value">{{myOpenid}}</text>
    </view>
    <view wx:else class="loading-tip">正在获取微信身份...</view>
  </view>

  <!-- Admin Panel -->
  <view wx:else class="panel">
    <view class="top-bar">
      <text class="top-title">管理后台</text>
      <button class="logout-btn" bindtap="logout">退出</button>
    </view>

    <view class="tab-bar">
      <view class="tab-bar-inner">
        <text class="tab-bar-item {{currentTab === 'homes' ? 'active' : ''}}" data-tab="homes" bindtap="switchTab">校友之家</text>
        <text class="tab-bar-item {{currentTab === 'logs' ? 'active' : ''}}" data-tab="logs" bindtap="switchTab">操作日志</text>
      </view>
    </view>

    <view wx:if="{{currentTab === 'homes'}}">
      <view class="toolbar">
        <text class="count">共 {{homes.length}} 个校友之家</text>
        <button class="add-btn" bindtap="addHome">+ 新增</button>
      </view>
    </view>

    <scroll-view wx:if="{{currentTab === 'homes'}}" scroll-y class="list-scroll">
      <view wx:for="{{homes}}" wx:key="_id" class="home-block">
        <view class="home-row">
          <view class="row-info">
            <text class="row-name">{{item.name}}</text>
            <text class="row-city">{{item.city}}</text>
          </view>
          <view class="row-actions">
            <button class="edit-btn" data-id="{{item._id}}" bindtap="editHome">编辑</button>
            <button class="delete-btn" data-id="{{item._id}}" data-name="{{item.name}}" bindtap="deleteHome">删除</button>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- Logs -->
    <scroll-view wx:elif="{{currentTab === 'logs'}}" scroll-y class="list-scroll">
      <view wx:if="{{logsLoading}}" class="loading-tip">加载中...</view>
      <view wx:elif="{{logs.length === 0}}" class="empty-tip">暂无操作日志</view>
      <view wx:for="{{logs}}" wx:key="_id" class="log-item">
        <view class="log-top">
          <text class="log-admin">{{item.adminName}}</text>
          <text class="log-action-tag">{{item.actionLabel}}</text>
          <text class="log-date">{{item.createTime}}</text>
        </view>
        <view class="log-detail">{{item.detail.name || item.detail.nickname || '-'}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- Custom Confirm Modal -->
  <view wx:if="{{modalVisible}}" class="modal-overlay" bindtap="hideModal">
    <view class="modal-box" catchtap="">
      <view class="modal-title">{{modalTitle}}</view>
      <view class="modal-content">{{modalContent}}</view>
      <view class="modal-actions">
        <button class="modal-btn cancel" bindtap="hideModal">取消</button>
        <button class="modal-btn confirm {{modalCountdown > 0 ? 'disabled' : ''}}" bindtap="handleModalConfirm" disabled="{{modalCountdown > 0}}">确认删除{{modalCountdown > 0 ? ' (' + modalCountdown + 's)' : ''}}</button>
      </view>
    </view>
  </view>
</view>
