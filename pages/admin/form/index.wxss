.page {
  min-height: 100vh;
  background: #f5f7f8;
}

.header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #0b5d4a;
  color: #ffffff;
}

.back-btn {
  flex-shrink: 0;
  min-width: auto;
  height: 52rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(255,255,255,0.4);
  border-radius: 6px;
  background: transparent;
  color: #ffffff;
  font-size: 24rpx;
}

.header-title {
  font-size: 30rpx;
  font-weight: 700;
}

.form {
  padding: 24rpx;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  margin-bottom: 10rpx;
  color: #4e5c57;
  font-size: 26rpx;
  font-weight: 600;
}

.required {
  color: #d94a4a;
}

.input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dbe4e0;
  border-radius: 6px;
  background: #ffffff;
  color: #17201d;
  font-size: 26rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 320rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #dbe4e0;
  border-radius: 6px;
  background: #ffffff;
  color: #17201d;
  font-size: 26rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.picker {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dbe4e0;
  border-radius: 6px;
  background: #ffffff;
  color: #17201d;
  font-size: 26rpx;
  box-sizing: border-box;
}

.region-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.region-row picker {
  flex: 1;
}

.region-sep {
  color: #8d9b95;
  font-size: 28rpx;
  flex-shrink: 0;
}

.locate-btn {
  width: 100%;
  height: 72rpx;
  border: 1rpx dashed #0b5d4a;
  border-radius: 6px;
  background: #e8f3ef;
  color: #0b5d4a;
  font-size: 26rpx;
  font-weight: 600;
}

.coord-row {
  display: flex;
  gap: 16rpx;
  margin-top: 10rpx;
}

.coord-text {
  color: #6d7a75;
  font-size: 22rpx;
}

.address-preview {
  margin-top: 8rpx;
  padding: 12rpx 16rpx;
  border-radius: 4px;
  background: #f0f3f1;
  color: #2b3a35;
  font-size: 24rpx;
  line-height: 1.4;
}

/* Tags */
.tag-row {
  display: flex;
  gap: 12rpx;
}

.tag-input {
  flex: 1;
}

.tag-add-btn {
  flex-shrink: 0;
  min-width: auto;
  height: 72rpx;
  padding: 0 24rpx;
  border: 1rpx solid #0b5d4a;
  border-radius: 6px;
  background: #ffffff;
  color: #0b5d4a;
  font-size: 24rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 14rpx;
  border-radius: 6px;
  background: #edf4f1;
  color: #0b5d4a;
  font-size: 24rpx;
}

.tag-x {
  color: #6d7a75;
  font-size: 28rpx;
  line-height: 1;
}

/* Photos */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.photo-item {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  border-radius: 6px;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-x {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.6);
  color: #ffffff;
  font-size: 28rpx;
  line-height: 32rpx;
  text-align: center;
}

.photo-add {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 150rpx;
  border: 2rpx dashed #cbd8d3;
  border-radius: 6px;
  background: #ffffff;
}

.photo-add-icon {
  color: #8d9b95;
  font-size: 48rpx;
  line-height: 1;
}

/* Video */
.upload-btn {
  width: 100%;
  height: 72rpx;
  border: 1rpx dashed #0b5d4a;
  border-radius: 6px;
  background: #e8f3ef;
  color: #0b5d4a;
  font-size: 26rpx;
  font-weight: 600;
}

.video-preview-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #dbe4e0;
  border-radius: 6px;
  background: #ffffff;
}

.video-name {
  flex: 1;
  color: #17201d;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.video-x {
  color: #8d9b95;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
}

/* Save */
.save-btn {
  width: 100%;
  height: 80rpx;
  margin-top: 20rpx;
  border-radius: 8px;
  background: #0b5d4a;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

.save-btn.disabled {
  background: #cbd8d3;
}
